TOKEN="your_token_here"

# URL del frontend para los enlaces en correos
FRONTEND_URL=http://localhost:3000

# Configuración de correo electrónico
# Para desarrollo local (MailDev/MailHog):
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_FROM="NeuroScreen <noreply@neuroscreen.com>"

# Para Gmail (producción académica):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_IGNORE_TLS=false
# MAIL_USER=tu-email@gmail.com
